# ===========================
# ENVIRONMENT CONFIGURATION
# ===========================
# Copy this file to .env.local and fill in your values

# ===========================
# APPLICATION
# ===========================
NODE_ENV=development
APP_NAME=TimeAI Watch Store
APP_URL=http://localhost:3000

# ===========================
# FRONTEND
# ===========================
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=TimeAI Watch Store

# ===========================
# BACKEND
# ===========================
BACKEND_PORT=3000

# ===========================
# DATABASE (PostgreSQL)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timeai_db
DB_USER=timeai_user
DB_PASSWORD=timeai_password
DB_SSL=false
DB_LOG_QUERIES=true

# ===========================
# REDIS
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=timeai_password
REDIS_DB=0
REDIS_URL=redis://:timeai_password@localhost:6379

# ===========================
# ELASTICSEARCH
# ===========================
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PREFIX=timeai_

# ===========================
# AUTHENTICATION
# ===========================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=7d

# OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_CALLBACK_URL=http://localhost:3000/api/auth/apple/callback

# ===========================
# PAYMENT PROCESSING (Stripe)
# ===========================
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# ===========================
# EMAIL SERVICE
# ===========================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM=noreply@timeai-watch.com
SMTP_FROM_NAME=TimeAI Watch Store

# ===========================
# AI/ML SERVICES
# ===========================
# OpenAI
OPENAI_API_KEY=sk_test_your_openai_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048

# ===========================
# AWS SERVICES
# ===========================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=timeai-watch-store
AWS_S3_URL=https://timeai-watch-store.s3.amazonaws.com
AWS_CLOUDFRONT_URL=https://d123.cloudfront.net

# ===========================
# THIRD-PARTY SERVICES
# ===========================
# Cloudinary (Image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# SendGrid (Email service)
SENDGRID_API_KEY=SG.your_sendgrid_key

# ===========================
# LOGGING & MONITORING
# ===========================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE=logs/app.log
SENTRY_DSN=https://your_sentry_dsn

# ===========================
# SECURITY
# ===========================
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================
# FEATURE FLAGS
# ===========================
FEATURE_VIRTUAL_TRY_ON=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_CHATBOT=true
FEATURE_ANALYTICS=true
FEATURE_AR_VIEWER=true

# ===========================
# DEVELOPMENT
# ===========================
DEBUG=true
VERBOSE=true
MOCK_DATA=true
SEED_DATABASE=false

# ===========================
# ANALYTICS
# ===========================
GOOGLE_ANALYTICS_ID=UA-your-id
MIXPANEL_TOKEN=your_mixpanel_token

# ===========================
# DEPLOYMENT
# ===========================
DEPLOYMENT_ENV=development
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_INSTANCE_TYPE=t3.medium
